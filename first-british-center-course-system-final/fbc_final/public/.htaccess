Options -Indexes
RewriteEngine On
RewriteRule ^api/?$ /api/index.php [L,QSA]
RewriteRule ^api/(.*)$ /api/index.php?action=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
<FilesMatch "^\.(env|git|sql|md)$">
 Require all denied
</FilesMatch>
