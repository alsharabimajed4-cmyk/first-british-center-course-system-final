APP_ENV=production
APP_URL=https://courses.example.com
APP_TIMEZONE=Asia/Aden
FORCE_SECURE_COOKIES=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=first_british_courses
DB_USER=first_british
DB_PASSWORD=CHANGE_ME

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://courses.example.com/api/?action=google_callback

# Optional OCR engine. Example: /usr/bin/tesseract
TESSERACT_BIN=

# Optional LiveKit integration reserved for classroom phase
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
